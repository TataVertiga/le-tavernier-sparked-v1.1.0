{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "index.ts",
    "core/**/*.ts",
    "events/**/*.ts",
    "services/**/*.ts",
    "commands/**/*.ts",
    "tools/**/*.ts",
    "utils/**/*.ts",
    "state/**/*.ts",
    "data/**/*.json",
    "types/**/*.d.ts"
  ]
}

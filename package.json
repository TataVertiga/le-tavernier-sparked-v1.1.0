{
  "name": "le-tavernier-bot",
  "version": "1.1.1",
  "description": "Bot Discord médiéval Le Tavernier",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node --enable-source-maps dist/index.js",
    "start:build": "npm run build && node --enable-source-maps dist/index.js",
    "pack:source": "node --import tsx tools/clean-pack.ts",
    "pack:deploy": "node --import tsx tools/deploy-pack.ts",
    "release": "npm run check && npm run pack:deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@atproto/api": "0.19.19",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^181.0.0",
    "node-cron": "^4.6.0",
    "twitter-api-v2": "^1.29.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "archiver": "^8.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20 <25"
  }
}

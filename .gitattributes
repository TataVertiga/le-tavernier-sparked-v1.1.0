# Normalisation des fins de lignes
* text=auto

# --- Code & Config (LF dans le dépôt)
*.ts     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.env    text eol=lf
*.txt    text eol=lf

# --- Binaires (ne jamais modifier les fins de lignes)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.tgz    binary
*.mp3    binary
*.mp4    binary
*.mov    binary
*.avi    binary
*.pdf    binary

# --- Fichiers spécifiques à ton projet
data/credentials.json text eol=lf

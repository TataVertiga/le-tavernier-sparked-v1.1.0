# Copie ce fichier en .env pour un test local. Ne partage et ne commit jamais le .env réel.

# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
CHANNEL_ID=
ADMIN_ROLE_ID=
DISCORD_TWITCH_ROLE_ID=
DISCORD_YOUTUBE_ROLE_ID=
DISCORD_CLIPS_CHANNEL_ID=
GIVEAWAY_CHANNEL_ID=
GUEUX_ROLE_ID=
WELCOME_CHANNEL_ID=
PRESENTATION_CHANNEL_ID=
ROLES_CHANNEL_ID=
RULE_MESSAGE_ID=

# Démarrage et comportement
PORT=10000
LOG_LEVEL=info
TIMEZONE=Europe/Paris
DEPLOY_COMMANDS_ON_START=true

# Twitch live
TWITCH_ENABLED=true
TWITCH_USERNAME=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHECK_EVERY=60

# Twitch clips
TWITCH_CLIPS_ENABLED=true
TWITCH_CLIPS_CHECK_EVERY=300
TWITCH_CLIPS_MIN_VIEWS=0
TWITCH_CLIPS_SINCE_HOURS=6

# X / Twitter — OAuth 1.0a User Context, accès en lecture-écriture
TWITTER_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Autres réseaux (laisser false pour les désactiver explicitement)
FACEBOOK_ENABLED=false
FB_PAGE_ID=
FB_PAGE_TOKEN=
META_GRAPH_VERSION=v24.0
BLUESKY_ENABLED=false
BSKY_SERVICE=https://bsky.social
BSKY_IDENTIFIER=
BSKY_PASSWORD=
THREADS_ENABLED=false
THREADS_ACCESS_TOKEN=

# YouTube
YOUTUBE_ENABLED=true
YOUTUBE_CHANNEL_ID=
YOUTUBE_RSS_URL=
YOUTUBE_API_KEY=

# Anniversaires Google Sheets
ANNIV_ENABLED=true
ANNIV_CHANNEL_ID=
GOOGLE_SHEET_ID=
GOOGLE_API_KEY=

# TikTok automatique
TIKTOK_AUTOCONVERT_ENABLED=false
TIKTOK_AUTOCONVERT_ADMIN_ONLY=true
TIKTOK_DELETE_ORIGINAL=false
TIKTOK_ALLOWED_CHANNEL_IDS=
TIKTOK_ROLE_ID=

# GIF du mardi
MARDI_GIF_ENABLED=true
MARDI_CHANNEL_ID=
MARDI_GIF_URL=https://tenor.com/b0kf5.gif
